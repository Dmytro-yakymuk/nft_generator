# Скопіювати в .env (cp .env.example .env) і заповнити. Файл .env не потрапляє в git.
# Усі змінні необов'язкові: без них платформа запускається на http://localhost:9012.

# База даних і секрет для підпису токенів доступу.
POSTGRES_PASSWORD=postgres
TOKEN_SECRET=change-me-to-a-long-random-string

# Порти на хості.
APP_PORT=9012
DB_PORT=5432

# Публічна адреса платформи. З неї формуються базовий URI контракту й посилання
# на зображення в метаданих, тому її треба задати ДО генерації й розгортання контракту.
# З ngrok: PUBLIC_URL=https://<NGROK_DOMAIN>
PUBLIC_URL=

# HTTP-шлюз, через який веб-застосунок відкриває файли колекції в IPFS (за замовчуванням вузол платформи
# http://localhost:8080). Для публічної адреси - публічний шлюз, наприклад IPFS_GATEWAY_URL=https://ipfs.io
IPFS_GATEWAY_URL=

# Мережа Ethereum, на яку застосунок перемикає MetaMask (формат wallet_addEthereumChain).
# За замовчуванням - локальний Anvil (make chain). Для Sepolia:
#   CHAIN_ID=0xaa36a7
#   CHAIN_NAME=Sepolia
#   CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#   CHAIN_EXPLORER_URL=https://sepolia.etherscan.io
CHAIN_ID=
CHAIN_NAME=
CHAIN_RPC_URL=
CHAIN_EXPLORER_URL=

# Розгорнутий контракт колекції (записується після розгортання; деталі - contracts/deployments/<мережа>.json).
CONTRACT_ADDRESS=
CONTRACT_PROJECT_ID=

# ngrok (make tunnel): authtoken і безкоштовний сталий домен з https://dashboard.ngrok.com
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Опис колекції в метаданих (назва токена формується як "<назва проєкту> #<id>").
COLLECTION_NAME=
COLLECTION_DESCRIPTION=

# Скільки зображень генерується одночасно (0 або порожньо - за кількістю ядер процесора)
GENERATION_WORKERS=
# Стиснення PNG згенерованих зображень: default (за замовчуванням), best-speed - кодування в кілька разів
# швидше, файли приблизно на третину більші; best-compression, none
GENERATION_PNG_COMPRESSION=

# Дашборд читає події Transfer контракту колекції з вузла мережі (eth_getLogs).
# CHAIN_SERVER_RPC_URL - вузол для сервера, якщо він інший, ніж CHAIN_RPC_URL (напр. з ключем API,
# який не можна показувати в браузері); у Docker за замовчуванням - CHAIN_RPC_URL, а без нього - http://anvil:8545.
# CHAIN_LOGS_BLOCK_RANGE - найбільший діапазон блоків одного запиту eth_getLogs (за замовчуванням 10000;
# publicnode.com приймає до 50000).
CHAIN_SERVER_RPC_URL=
CHAIN_LOGS_BLOCK_RANGE=

# S3-сумісне сховище (Storj, MinIO) для кнопки завантаження файлів колекції; необов'язково.
S3_GATEWAY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Закріплення опублікованих колекцій у Filebase (кнопка Pin in Filebase або make pin-filebase PROJECT=<id>):
# IPFS-бакет і S3-ключі зі сторінки Access Keys консолі Filebase.
FILEBASE_BUCKET=
FILEBASE_S3_KEY=
FILEBASE_S3_SECRET=

# Мінт-сайти на піддоменах: <адреса>.<MINT_SITE_DOMAIN> поруч із /sites/<адреса> (за замовчуванням localhost:
# http://<адреса>.localhost:9012); для власного домену потрібні DNS-запис *.<домен> і сертифікат на нього.
# Порожнє значення вимикає піддомени (публічна адреса через тунель: лишаються тільки /sites/<адреса>).
# MINT_SITE_DOMAIN=localhost

# Розгортання в Sepolia з командного рядка й верифікація коду на Etherscan.
# Окремий тестовий гаманець, лише з тестовими коштами (крани Sepolia).
SEPOLIA_DEPLOYER_ADDRESS=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# Тестовий гаманець покупця для перевірки мінт-сайту (лише тестові кошти).
SEPOLIA_BUYER_ADDRESS=
SEPOLIA_BUYER_PRIVATE_KEY=
